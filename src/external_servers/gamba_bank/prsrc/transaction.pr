GETF modules/webpr.pr
GETF modules/io.pr
GETF modules/files.pr
GETF modules/math.pr
GETF login_functions.pr
GET split

// Get user details
gml ("gamba_bank/login_name.gml"!) -> name
gml ("gamba_bank/login_password.gml"!) -> password

// Read database
read ("data/currency.json"!) -> currency_data
json_upack (currency_data;name) -> data

// Check if user exists
if [data="false"B] _gml ("gamba_bank/error.gml"!;"Transaction failedK User not found!"!)_ _pass ()_

// Check if user password is correct
json_upack (data;"password"!) -> user_password
if [password|user_password] _gml ("gamba_bank/error.gml"!;"Transaction failed: Password incorrect!"!_

// Get values ready
split (url_code;"|"!;"0"+) -> receiver
split (url_code;"|"!;"1"+) -> amount

// Unpack users money amount
json_upack (data;"money"!) -> sender_money
if [sender_money<amount] _gml ("gamba_bank/error.gml"!;"Transaction failed: Not enough money!"!)_ _pass ()_

// Unpack receiver's money amount
json_upack (currency_data;receiver) -> receiver_data
if [receiver_data="false"B] _gml ("gamba_bank/error.gml"!;"Transaction failed: Receiver's account not found!"!)_ _pass ()_
json_upack (receiver_data;"money"!) -> receiver_money

// Add and Subtract money
add (receiver_money;amount) -> receiver_money
sub (sender_money;amount) -> sender_money

// Repack new values
json_pack (data;"money"!;sender_money) -> user_data
json_pack (receiver_data;"money"!;receiver_money) -> receiver_data
json_pack (currency_data;name;user_data) -> currency_data
json_pack (currency_data;receiver;receiver_data) -> currency_data

// Save data to currency.json
write ("data/currency.json"!;currency_data)